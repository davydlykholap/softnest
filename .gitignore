# Visual Studio files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.slnx

# Database and build caches (Visual Studio internal)
*.db
*.db-shm
*.db-wal
*.opendb

# Environment configurations (Contains credentials/keys)
.env
.env.local
.env.*.local
/studio/dist/
/studio/.sanity/
*.tsbuildinfo

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Script file exclusions
deploy.ps1
push.bat

# Node/Web dependencies (Optional but highly recommended)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor settings
.idea/
.vscode/

# Build artifacts
/.next/
/out/
/softnest.zip
/.next-dev*.log

# Local source backups
/src*.zip

# Editorial originals and private migration backups stay local.
/content/inbox/
/content/backups/

# Rebuilt from Sanity (or an explicit local seed preview).
/src/content/generated/
/studio/schema.json
/studio/*.log

# Authentication tokens must never be committed.
.env.*
!.env.example
*.zip
