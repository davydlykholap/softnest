{
  "name": "softnest-studio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "register": "sanity deploy --external --url https://studio.softnestcare.ca --yes",
    "typecheck": "tsc --noEmit",
    "import:content": "sanity exec scripts/import-content.mjs --with-user-token",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.20.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "js-yaml": "^3.15.2",
    "smol-toml": "^1.9.1",
    "typeid-js": {
      "uuid": "^11.1.1"
    },
    "undici": "7.30.1",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.21.1 <12"
  },
  "packageManager": "npm@11.21.1"
}
