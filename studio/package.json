{
  "name": "softnest-studio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "import:content": "sanity exec scripts/import-content.mjs --with-user-token",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.12.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "js-yaml": "^3.15.1",
    "smol-toml": "^1.6.1",
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}
