{
  "name": "softnest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:website",
    "dev:website": "npm run dev --workspace @softnest/website",
    "dev:studio": "npm run dev --workspace @softnest/studio",
    "dev:sf0": "npm run dev --workspace @softnest/sf0",
    "build": "npm run build:website",
    "build:website": "npm run build --workspace @softnest/website",
    "build:studio": "npm run build --workspace @softnest/studio",
    "build:sf0": "npm run build --workspace @softnest/sf0",
    "check": "npm run check:boundaries && npm run test:audit && npm run check:studio && npm run check:website && npm run check:sf0",
    "check:website": "npm run check --workspace @softnest/website",
    "check:studio": "npm run check --workspace @softnest/studio",
    "check:sf0": "npm run check --workspace @softnest/sf0",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "studio": "npm run dev:studio",
    "studio:check": "npm run check:studio",
    "studio:deploy": "npm run build:studio && node tools/deploy-pages.mjs studio && npm run register --workspace @softnest/studio",
    "sf0:deploy": "npm run check:sf0 && node tools/deploy-pages.mjs sf0",
    "package:sf0": "npm run package:static --workspace @softnest/sf0",
    "content:types": "npm run typegen --workspace @softnest/studio",
    "audit:dependencies": "node tools/dependency-audit.mjs",
    "test:audit": "node --test tools/dependency-audit.test.mjs",
    "lint": "npm run lint --workspace @softnest/website",
    "content:seed-local-copy": "npm run content:seed-local-copy --workspace @softnest/website",
    "content:sync": "npm run content:sync --workspace @softnest/website",
    "content:seed": "npm run content:seed --workspace @softnest/website",
    "content:import:check": "npm run content:import:check --workspace @softnest/website",
    "content:import": "npm run content:import --workspace @softnest/website",
    "content:verify": "npm run content:verify --workspace @softnest/website",
    "test:unit": "npm run test:unit --workspace @softnest/website",
    "verify:export": "npm run verify:export --workspace @softnest/website",
    "images:generate": "npm run images:generate --workspace @softnest/website",
    "prepare:export": "npm run prepare:export --workspace @softnest/website",
    "preview": "npm run preview --workspace @softnest/website",
    "content:repair-ids": "npm run content:repair-ids --workspace @softnest/website",
    "content:publish-reviews": "npm run content:publish-reviews --workspace @softnest/website",
    "test:e2e:built": "npm run test:e2e:built --workspace @softnest/website",
    "test:e2e": "npm run test:e2e --workspace @softnest/website",
    "test:a11y:built": "npm run test:a11y:built --workspace @softnest/website",
    "sites:check": "node tools/check-sites.mjs"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "minimatch@>=10 <11": "11.0.5",
    "adm-zip": "0.6.1",
    "js-yaml": "^3.15.2",
    "smol-toml": "^1.9.1",
    "typeid-js": {
      "uuid": "^11.1.1"
    },
    "undici": "7.30.2"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.2 <13"
  },
  "packageManager": "npm@12.2.2"
}
