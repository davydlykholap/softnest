{
  "name": "@softnest/studio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build && node scripts/prepare-static.mjs",
    "deploy": "npm run build && node ../../tools/deploy-pages.mjs studio && npm run register",
    "register": "sanity deploy --external --url https://studio.softnestcare.ca --yes",
    "typecheck": "tsc --noEmit",
    "import:content": "sanity exec scripts/import-content.mjs --with-user-token",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.21.0",
    "styled-components": "6.6.0",
    "@sanity/client": "^8.14.1",
    "@softnest/content": "1.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.21.1 <12"
  },
  "packageManager": "npm@11.21.1",
  "type": "module"
}
