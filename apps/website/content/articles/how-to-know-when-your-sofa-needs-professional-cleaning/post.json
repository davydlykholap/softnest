      "_type": "block",
      "children": [
        {
          "_key": "mississauga-service-prefix",
          "_type": "span",
          "marks": [],
          "text": "For more information about our local service, visit our "
        },
        {
          "_key": "mississauga-service-anchor",
          "_type": "span",
          "marks": [
            "mississauga-page"
          ],
          "text": "Sofa & Upholstery Cleaning in Mississauga"
        },
        {
          "_key": "mississauga-service-suffix",
          "_type": "span",
          "marks": [],
          "text": " page."
        }
      ],
      "markDefs": [
        {
          "_key": "mississauga-page",
          "_type": "link",
          "href": "/location/mississauga/"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "sofa-signs-28",
      "_type": "block",
      "children": [
        {
          "_key": "sofa-signs-28-text",
          "_type": "span",
          "marks": [],
          "text": "Need Upholstery Cleaning?"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "sofa-signs-29",
      "_type": "block",
      "children": [
        {
          "_key": "sofa-signs-29-text",
          "_type": "span",
          "marks": [],
          "text": "For an accurate quote, tell us the furniture type and number of seats by phone, message or the optional website form. You can share photos if you would like to; they are optional too."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "sofa-signs-30",
      "_type": "block",
      "children": [
        {
          "_key": "sofa-signs-30-text",
          "_type": "span",
          "marks": [],
          "text": "SoftNest Fabric Care provides professional upholstery and fabric cleaning throughout Mississauga and surrounding areas of the GTA."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "softnest-local-booking",
      "_type": "block",
      "children": [
        {
          "_key": "local-0",
          "_type": "span",
          "marks": [],
          "text": "If your sofa is ready for attention, our "
        },
        {
