      "_key": "editorial-115",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s114",
          "text": "A thorough rinse to recover loosened soil and cleaning solution.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
