      "_type": "block",
      "_key": "editorial-117",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s116",
          "text": "Deodorizing and sanitizing with a fabric-appropriate approach.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "editorial-119",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s118",
